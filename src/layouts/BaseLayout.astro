---
import '@fontsource-variable/inter';
import '@fontsource-variable/fraunces';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getSettings, abs, SITE } from '../lib/utils';
import { personNode, websiteNode, breadcrumbNode, webPageNode, graph, parseCustom, type Crumb } from '../lib/schema';

interface Props {
  title: string; // page name (used for H1 fallback / breadcrumbs)
  description?: string | null;
  seo?: any;
  schema?: any;
  crumbs?: Crumb[];
  ogType?: string;
  image?: string | null;
  imageAlt?: string | null;
  faq?: { question: string; answer: string }[] | null;
  extraNodes?: any[]; // Service, BlogPosting, VideoObject…
  pageType?: string; // default schema.org page type
  isHome?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
}

const p = Astro.props;
const settings = await getSettings();
const seo = p.seo ?? {};
const siteName = settings.site_name || 'Arjun R Sharma';
const path = Astro.url.pathname;
const url = new URL(path, SITE).toString();
const canonical = seo.canonical ? abs(seo.canonical) : url;

const metaTitle = seo.meta_title || (p.isHome ? siteName : `${p.title} — ${siteName}`);
const metaDescription = seo.meta_description || p.description || settings.tagline || '';
const ogTitle = seo.og_title || seo.meta_title || p.title;
const ogDescription = seo.og_description || metaDescription;
const ogImage = abs(seo.og_image || p.image || settings.default_og_image || '/og-default.png');
const ogImageAlt = seo.og_image ? seo.og_image_alt : p.image ? p.imageAlt : settings.default_og_image_alt;

const crumbs = p.crumbs ?? [];
const nodes: any[] = [
  websiteNode(settings),
  personNode(settings),
  webPageNode({
    url: canonical!,
    name: ogTitle,
    description: metaDescription,
    pageType: p.schema?.page_type || p.pageType,
    crumbs,
    faq: p.faq,
    image: p.image ?? undefined,
    about: p.isHome ? { '@id': `${SITE}/#person` } : undefined,
  }),
  crumbs.length > 1 ? breadcrumbNode(canonical!, crumbs) : null,
  ...(p.extraNodes ?? []),
];
const custom = parseCustom(p.schema?.custom_jsonld, path);
const jsonld = JSON.stringify(graph(nodes), (_k, v) => (v === undefined ? undefined : v));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{metaTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    {seo.noindex && <meta name="robots" content="noindex, follow" />}
    {settings.google_site_verification && <meta name="google-site-verification" content={settings.google_site_verification} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={p.ogType || 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImage} />
    {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta property="og:locale" content="en_IN" />
    {p.publishedTime && <meta property="article:published_time" content={p.publishedTime.toISOString()} />}
    {p.modifiedTime && <meta property="article:modified_time" content={p.modifiedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    {ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}

    <script type="application/ld+json" set:html={jsonld} />
    {custom.map((c) => <script type="application/ld+json" set:html={JSON.stringify(c)} />)}

    {settings.ga4_id && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${settings.ga4_id}`}></script>
        <script is:inline define:vars={{ id: settings.ga4_id }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', id);
        </script>
      </>
    )}
    {settings.head_code && <Fragment set:html={settings.head_code} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header settings={settings} current={path} />
    <main id="main">
      {crumbs.length > 1 && <Breadcrumbs crumbs={crumbs} />}
      <slot />
    </main>
    <Footer settings={settings} />
  </body>
</html>

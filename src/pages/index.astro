---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBody from '../components/PageBody.astro';
import { getPage } from '../lib/utils';
const page = await getPage('home');
---
<BaseLayout title={page.title} seo={page.seo} schema={page.schema} faq={page.faq?.items} image={page.hero?.image} imageAlt={page.hero?.image_alt} pageType="WebPage" isHome>
  <PageBody page={page} />
</BaseLayout>

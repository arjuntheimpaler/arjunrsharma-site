---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBody from '../components/PageBody.astro';
import { getPage } from '../lib/utils';
const page = await getPage('faq');
---
<BaseLayout title={page.title} seo={page.seo} schema={page.schema} faq={page.faq?.items} image={page.hero?.image} imageAlt={page.hero?.image_alt} pageType="FAQPage" crumbs={[{ name: 'Home', path: '/' }, { name: page.title, path: '/faq/' }]}>
  <PageBody page={page} />
</BaseLayout>
